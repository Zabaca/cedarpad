# Build context for the canvas container is the repo root (packages/canvas
# wrangler.jsonc `image_build_context: "../.."`). Keep the image lean and never bake
# node_modules (installed in-image) or secrets.
**/node_modules
.git
**/dist
**/.wrangler
**/.persist
graphify-out

# Never bake env/secrets or the local dev DB into the image; the Worker injects env
# at process spawn.
**/.env
**/.dev.vars
**/.web-poc-dev.db
**/.web-poc-dev.db-*

# Workspace skills are workspace CONTENT (R2 skills.tar, restored at boot — ADR-0013),
# never image content. A locally-authored skill on the deploy machine must not leak
# into every workspace's image.
packages/canvas/.claude
