{
  "name": "@cedarpad/pty-server",
  "private": true,
  "type": "module",
  "description": "Console PTY server (ADR-0021). Deliberately its own npm-installed island — see README.md.",
  "scripts": {
    "start": "node server.mjs",
    "postinstall": "node -e \"const f='node_modules/node-pty/prebuilds/'+process.platform+'-'+process.arch+'/spawn-helper';require('fs').existsSync(f)&&require('fs').chmodSync(f,0o755)\""
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  }
}
