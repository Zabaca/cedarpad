# The default workspace's sandbox on the sandbox site (sbx): everything about it that is a choice, in one file.
# Read (sourced) by scripts/deploy-sandbox.sh, which is the only thing that reads it; no zbc module exists for
# sandboxes, so this file and that script are the record of what the sandbox is. Plain NAME=value lines.
#
# Why a sandbox at all: the workspace VM holds 8.5 GiB of ryzen-9's memory while nobody uses it; a sandbox sleeps
# when idle and holds none. The option: Home's docs/problems/cedarpad-workspace-vm-holds-memory-while-idle/.

# The sandbox's name, so the address of its stack is https://cedarpad-default.sbx.zabaca.com and of its supervisor
# https://4599-cedarpad-default.sbx.zabaca.com (what the Worker's SELF_HOSTED_WORKSPACES entry names).
SANDBOX_NAME=cedarpad-default

# The image's repository name in the sandbox site's registry, and the Dockerfile that makes it (its `sandbox` form).
IMAGE_NAME=cedarpad-workspace
DOCKERFILE=packages/canvas/Dockerfile

# vite's port is the sandbox's main address; the supervisor's is reached at its port-prefixed address.
STACK_PORT=4510
SUPERVISOR_PORT=4599

# Its size: what the spike measured (the stack awake is 1.2 GiB under gVisor, 1.3 GiB in an agent turn).
MEM_REQUEST=1536Mi
MEM_LIMIT=4Gi
CPU_REQUEST=1
CPU_LIMIT=4

# The model route: the agent's connections to api.anthropic.com go to claude-mitm-proxy on the host, which swaps the
# placeholder the Worker pushes for the fleet's real token. The real token is never in the sandbox.
ROUTE=anthropic

# Hosts the sandbox may reach beyond the site's list (sbx egress-site): the platform's origin, which vite's
# materialize middleware and the bridge call, this account's R2 endpoint (R2_ENDPOINT, the host only), and Fredrin's
# MCP server, which a chat's fredrin connections reach (refused at the 2026-11-09 cutover until added).
EGRESS_ALLOW="app.cedarpad.com 99a19e584439be0568f33aad0477372b.r2.cloudflarestorage.com www.fredrin.com"

# Inside the image: the checkout's canvas package (the Agent SDK encodes this cwd into its session path, so it is
# the same as the container's and the VM's: worker/container-env.ts), and claude-mitm-proxy's certificate
# (the Dockerfile's sandbox form puts it there).
CANVAS_CWD=/app/agent-canvas/packages/canvas
CA_CERT=/etc/cedarpad/claude-proxy-ca.crt
