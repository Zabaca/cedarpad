{
  "name": "@cedarpad/canvas",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:bridge": "bun run --watch server/bridge.ts",
    "dev:web": "vite",
    "dev:e2e": "bash scripts/with-worktree-port.sh bash scripts/with-worktree-db.sh bun run scripts/dev.ts",
    "build": "vite build --config shell/vite.config.ts && bun run webpoc:build",
    "preview": "vite preview --port 4510",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./server ./src ./shell ./worker",
    "test:e2e": "bash scripts/with-worktree-port.sh bash scripts/with-worktree-db.sh playwright test",
    "test:e2e:ui": "bash scripts/with-worktree-port.sh bash scripts/with-worktree-db.sh playwright test --ui",
    "deploy": "bash scripts/deploy.sh",
    "webpoc:build": "cd web-poc && vite build",
    "webpoc:typecheck": "cd web-poc && tsc --noEmit",
    "webpoc:test": "cd web-poc && vitest run --passWithNoTests",
    "webpoc:db:generate": "cd web-poc && bunx --bun drizzle-kit generate",
    "webpoc:db:migrate": "cd web-poc && bun scripts/migrate.ts",
    "webpoc:seed": "cd web-poc && bun scripts/seed.ts",
    "webpoc:openapi:emit": "cd web-poc && bun scripts/emit-openapi.ts",
    "webpoc:gen:api": "cd web-poc && openapi-typescript ./openapi.json -o src/api-types.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.178",
    "@better-auth/api-key": "^1.6.0",
    "@cloudflare/sandbox": "0.12.1",
    "@heygen/liveavatar-web-sdk": "^0.0.18",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.19.2",
    "@libsql/client": "^0.15.0",
    "@mantine/core": "^7.15.0",
    "@mantine/hooks": "^7.15.0",
    "@mantine/notifications": "^7.15.0",
    "@tanstack/react-query": "^5.62.0",
    "@xyflow/react": "^12.3.0",
    "ably": "^2.5.0",
    "ai": "^5.0.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.20",
    "mermaid": "^11.15.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "^5.1.1",
    "zod": "^3.25.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@playwright/test": "^1.61.1",
    "@tldraw/tlschema": "5.1.1",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.1",
    "jsdom": "^29.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.0.0"
  }
}
