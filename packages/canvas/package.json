{
  "name": "@cedarpad/canvas",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:bridge": "bun run --watch server/bridge.ts",
    "dev:web": "vite",
    "dev:e2e": "bash scripts/with-worktree-port.sh bash scripts/with-worktree-db.sh bun run scripts/dev.ts",
    "build": "bun run gen:base-manifest && vite build --config shell/vite.config.ts",
    "gen:base-manifest": "bun run scripts/gen-base-manifest.ts",
    "gen:chart-skill": "bun run scripts/gen-chart-skill.ts",
    "preview": "vite preview --port 4510",
    "typecheck": "tsc --noEmit && bun run worker:typecheck",
    "worker:typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "test": "PLATFORM_RPC_ORIGIN= BETTER_AUTH_SECRET= bun test ./server ./shared ./src ./shell ./worker",
    "test:e2e": "bash scripts/with-worktree-port.sh bash scripts/with-worktree-db.sh playwright test",
    "test:e2e:ui": "bash scripts/with-worktree-port.sh bash scripts/with-worktree-db.sh playwright test --ui",
    "deploy": "bash scripts/deploy.sh",
    "webpoc:typecheck": "cd web-poc && tsc --noEmit",
    "webpoc:test": "cd web-poc && vitest run --passWithNoTests",
    "webpoc:db:generate": "cd web-poc && bunx --bun drizzle-kit generate",
    "webpoc:db:migrate:local": "bun run scripts/wrangler-local.ts d1 migrations apply PLATFORM_DB --local",
    "webpoc:db:migrate:local:e2e": "bash scripts/with-worktree-db.sh bun run scripts/wrangler-local.ts d1 migrations apply PLATFORM_DB --local"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "@anthropic-ai/sdk": "0.33.1",
    "@cloudflare/sandbox": "0.12.1",
    "@heygen/liveavatar-web-sdk": "^0.0.18",
    "@hono/mcp": "^0.3.1",
    "@libsql/client": "^0.15.0",
    "@livekit/agents": "^1.5.3",
    "@livekit/agents-plugin-anthropic": "^1.5.3",
    "@livekit/agents-plugin-silero": "^1.5.3",
    "@livekit/rtc-node": "^0.13.31",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tldraw/sync": "5.2.5",
    "@tldraw/sync-core": "5.2.5",
    "@xstate/react": "^6.1.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.38.3",
    "flint-chart": "^0.4.1",
    "hono": "^4.6.20",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.17.0",
    "mermaid": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "5.2.5",
    "vega": "^6.3.1",
    "vega-lite": "^6.4.3",
    "xstate": "^5.32.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@playwright/test": "^1.61.1",
    "@tldraw/tlschema": "5.2.5",
    "@tldraw/utils": "5.2.5",
    "@tldraw/validate": "5.2.5",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.1",
    "jsdom": "^29.1.0",
    "miniflare": "^4.20260708.1",
    "msw": "^2.15.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.5",
    "wrangler": "4.147.0"
  }
}
