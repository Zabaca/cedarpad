{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-canvas",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom domains: wrangler provisions the proxied DNS records + TLS certs and binds
  // both hosts to this worker (the cedarpad.com zone must be in this account). The
  // exact-match records take precedence over the zone's *.cedarpad.com wildcard.
  // app.cedarpad.com is CANONICAL; the worker 301s poc.cedarpad.com → app (cutover
  // 2026-07-17 — old share links and bookmarks keep working via the redirect).
  "routes": [
    { "pattern": "app.cedarpad.com", "custom_domain": true },
    { "pattern": "poc.cedarpad.com", "custom_domain": true }
  ],
  // Workers Logs: stream the Worker's console + request logs via `wrangler tail`
  // or the dashboard (replaces the ad-hoc /__diag route). Container stdout is
  // separate (sandbox getProcessLogs / CF container logs).
  "observability": { "enabled": true },
  // Dev-agent scheduler (ADR-0007, PRD #51 slice #63). Off-hours daily cron that wakes
  // the separate `dev-agent` sandbox (its own sleep schedule) and kicks one workflow run
  // via the Worker's `scheduled` handler, then lets it sleep. 09:00 UTC ≈ 02:00 PT — off
  // James's active hours. Interval is config here; the real workflow is #66.
  "triggers": { "crons": ["0 9 * * *"] },
  // Non-secret env for the mounted web-poc's Better Auth (same origin as the app in
  // prod). Secrets (VOYAGE_API_KEY, BETTER_AUTH_SECRET) are pushed via
  // workerSecrets, not here.
  "vars": {
    "BETTER_AUTH_URL": "https://app.cedarpad.com",
    "WEB_ORIGIN": "https://app.cedarpad.com",
    // Prod is James-only: Better Auth signup is disabled at the edge (dev leaves it
    // open — the var is unset in .dev.vars). See web-poc/worker/auth.ts. (PRD #49 #15)
    "AUTH_DISABLE_SIGNUP": "true",
    // Master breaker for ALL scheduled work (#94.5): with this "false" the cron fires and
    // no-ops. Enabled 2026-07-26 now that repo-connection (#96) and repo-defined Jobs
    // (ADR-0015) are live. It gates BOTH kinds of scheduled dispatch, so enabling the daily
    // materialize also enables the daily dev-agent run — deliberate, not a side effect.
    // What this arms today, at 09:00 UTC, on the only selected repo that defines jobs
    // (Zabaca/cedarpad — the other three have no .claude/jobs/):
    //   - materialize-mart-session-events (target: warehouse) — batch, no agent, no Conversation
    //   - improve-codebase-architecture   (target: agent)     — ends `end_turn needs_human`,
    //     so it surfaces candidates for review and never ships code unattended.
    // PREVIEW STAYS "false" on purpose: that worker shares production's platform D1 and R2,
    // so arming both would double-dispatch the same jobs against the same state.
    "DEV_AGENT_ENABLED": "true",
    // The GitHub App's public slug (github.com/apps/<slug>) for the workspace connect
    // flow (#193, ADR-0015). Not a secret; unset hides "Connect GitHub" in Settings.
    "GITHUB_APP_SLUG": "cedarpad",
    // The single-tenant owner every `ask_human`/Inbox Conversation gets filed under —
    // must be this deployment's Better Auth user.id (the platform D1 `user` table), not an
    // email. Single-tenant-only: revisit when #98 (multi-user) lands.
    "CANVAS_USER": "2hfe21p0OsrHWQBPgfKhwSH9ZYUK9ajw"
  },
  // The Shell SPA build (PRD #103). `bun run build` emits shell/dist — the Shell at `/`
  // and its `/assets/*`, plus the Notebook SPA under `/notebook` (shell/dist/notebook) —
  // and the edge Worker serves it all through env.ASSETS after the edge session gate.
  // `run_worker_first: true` means the Worker runs on every request (assets are never
  // auto-served pre-auth) and pulls files through the ASSETS binding.
  "assets": {
    "directory": "./shell/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      // The Dockerfile bakes the whole workspace (canvas + web-poc), so the build
      // context is the repo root (two levels up from this package), not the package.
      "image_build_context": "../..",
      // standard-1 is the proven instance type for this account; bump if the
      // vite + bridge + agent stack OOMs on cold boot.
      "instance_type": "standard-1",
      "max_instances": 3
    },
    {
      // Warehouse (ADR-0017, #236): the second container class, its own Dockerfile,
      // NO agent SDK — see ADR-0017 "Why two containers". standard-4 (4 vCPU, 12 GiB,
      // 20 GB disk) is deliberately oversized for chat/canvas but cheap here: container
      // billing is per-second-while-running, and this class only runs a few minutes a
      // day for the materialize Job (ADR-0015), never on the chat cold-boot path.
      // max_instances matches Sandbox's 3, NOT capped lower: a workspace is a deployment
      // (ADR-0008) and each one gets its own materialize pipeline, so a cap of 1 would
      // let only one workspace across the whole account materialize at a time — a second
      // workspace's job would queue or fail, and that failure would look like a
      // mysterious hang long after anyone remembered this line.
      "class_name": "Warehouse",
      "image": "./Dockerfile.warehouse",
      "image_build_context": "../..",
      "instance_type": "standard-4",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" },
      { "class_name": "Warehouse", "name": "Warehouse" },
      // One instance per canvas, hosting that canvas's tldraw sync room (ADR-0019, #288).
      // Unlike Sandbox/Warehouse this is NOT a container class — it is a plain SQLite-backed
      // DO, and its SQLite tables ARE the room's persistence.
      { "class_name": "CanvasSyncRoom", "name": "CANVAS_SYNC" },
      // One instance per WORKSPACE, the fan-out point for "this workspace's inbox changed"
      // (#383). Not a container class and — unlike CanvasSyncRoom — it stores NOTHING: it
      // holds subscriber sockets and forwards a topic, so the badge is pushed instead of
      // polled without a second copy of the inbox existing anywhere.
      { "class_name": "WorkspaceEvents", "name": "WORKSPACE_EVENTS" }
    ]
  },
  // Native R2 binding (ADR-0017, #238): the edge Worker (workerd) reads mart parquet and
  // canvas-state.json straight off this — no container wake for browsing. Separate from
  // the R2_* S3-compat vars above, which only ever get forwarded into the container's Bun
  // runtime (Bun.S3Client isn't available in workerd). Same bucket as R2_BUCKET; the name
  // here is a judgment call matching the container-env test fixture — confirm against the
  // real deploy secret before relying on this in prod.
  "r2_buckets": [{ "binding": "MART_BUCKET", "bucket_name": "agent-canvas" }],
  // Cloudflare Email Sending: outbound magic links + invitations (no vendor key —
  // the binding IS the credential). Sends as the APEX `cedarpad.com`, which MUST be
  // enabled for Email Sending before this ships — see the FROM note in
  // web-poc/worker/email.ts for that and the two DNS invariants it depends on.
  // Reaching arbitrary recipients (an invitee who has never written to us) requires
  // the Workers Paid plan, which the containers above already imply.
  // Deliberately NOT declared on the preview env: preview shares production's
  // platform D1, so a binding there would mail real people. web-poc/worker/email.ts
  // degrades to a logging no-op wherever the binding is absent.
  "send_email": [{ "name": "EMAIL" }],
  // The www worker's waitlist D1, ALSO bound here so /admin gets a waitlist view
  // (ADR-0014). Read-only from this worker; www owns the schema + migrations.
  "d1_databases": [
    {
      "binding": "WAITLIST",
      "database_name": "cedarpad-waitlist",
      "database_id": "eb4a65d7-6e26-4d98-b893-3b52f901726c"
    },
    // The platform data layer (ADR-0018, #265). Created once with
    // `wrangler d1 create cedarpad-platform`; schema applied with
    // `wrangler d1 migrations apply PLATFORM_DB --remote` (deploy.sh does this now).
    // Live since the cutover (#267); the Turso rollback path was retired in #268.
    {
      "binding": "PLATFORM_DB",
      "database_name": "cedarpad-platform",
      "database_id": "88690b7f-216c-4110-823e-9e50b346b974",
      // Drizzle's ledger + SQL live with the schema, not in the wrangler default `migrations/`.
      "migrations_dir": "web-poc/lib/db/migrations"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sandbox"] },
    // Warehouse (#236) is a new DO class, not a change to Sandbox's storage — a
    // separate migration tag, per wrangler's "one new_sqlite_classes entry per class
    // introduced" convention (mirrors how Sandbox itself was introduced under v1).
    { "tag": "v2", "new_sqlite_classes": ["Warehouse"] },
    // CanvasSyncRoom (#288). new_SQLITE_classes is required, not optional here: the room's
    // documents/tombstones/clock live in this DO's SQLite tables (sync-core's
    // SQLiteSyncStorage), so a KV-backed class would have nowhere to put them.
    { "tag": "v3", "new_sqlite_classes": ["CanvasSyncRoom"] },
    // WorkspaceEvents (#383) — its own tag, per wrangler's one-entry-per-class-introduced
    // convention. `new_sqlite_classes` even though the hub persists nothing: it is the
    // current default backend for a new class, and declaring the KV one would pin a
    // deprecated storage engine to a class that will never use either.
    { "tag": "v4", "new_sqlite_classes": ["WorkspaceEvents"] }
  ],
  // Preview environment (zbc: `apply preview canvas` -> `wrangler deploy --env
  // preview`). A SEPARATE worker `agent-canvas-preview` in the same account, on a
  // free *.workers.dev URL (no custom domain), so it never touches production's
  // poc.cedarpad.com. wrangler named environments do NOT inherit bindings/vars/
  // routes/containers — only main + compatibility_* — so the container, DO, and
  // migrations are redeclared here verbatim.
  "env": {
    "preview": {
      "name": "agent-canvas-preview",
      // No custom domain: serve on the account's <name>.<subdomain>.workers.dev.
      "workers_dev": true,
      "observability": { "enabled": true },
      // Better Auth is origin-sensitive — these are the deployed preview origin
      // (the account's workers.dev subdomain, from the first deploy).
      "vars": {
        "BETTER_AUTH_URL": "https://agent-canvas-preview.james-99a.workers.dev",
        "WEB_ORIGIN": "https://agent-canvas-preview.james-99a.workers.dev",
        "AUTH_DISABLE_SIGNUP": "true",
        "DEV_AGENT_ENABLED": "false",
        "GITHUB_APP_SLUG": "cedarpad",
        // Preview shares production's platform D1 (secrets.yaml is a copy) — same one user
        // row. D1 admits one writer, with an external write mid-request corrupting
        // concurrent readers (#276) — this sharing is pre-existing debt (it also shared
        // Turso before #268), not new. Give preview its own D1 database before using it
        // for anything real (see canvas.ts).
        "CANVAS_USER": "2hfe21p0OsrHWQBPgfKhwSH9ZYUK9ajw"
      },
      "assets": {
        "directory": "./shell/dist",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "containers": [
        {
          "class_name": "Sandbox",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "standard-1",
          "max_instances": 3
        },
        {
          // Mirrors the production block above (#236) — wrangler named environments
          // don't inherit `containers`/`durable_objects`/`migrations`, so this is
          // redeclared verbatim here, same as Sandbox already is.
          "class_name": "Warehouse",
          "image": "./Dockerfile.warehouse",
          "image_build_context": "../..",
          "instance_type": "standard-4",
          "max_instances": 3
        }
      ],
      "durable_objects": {
        "bindings": [
          { "class_name": "Sandbox", "name": "Sandbox" },
          { "class_name": "Warehouse", "name": "Warehouse" },
          // Redeclared verbatim from the top level (#288) — named envs inherit no
          // durable_objects. Preview gets its OWN room instances: DO storage is per-worker,
          // not shared like Turso/R2/D1 are.
          { "class_name": "CanvasSyncRoom", "name": "CANVAS_SYNC" },
          // Redeclared verbatim from the top level (#383), same reason. Preview gets its own
          // hubs — which is the right isolation even though it shares production's D1: a
          // preview tab and a production tab watching the same workspace are two streams,
          // and each re-reads the rows for itself anyway.
          { "class_name": "WorkspaceEvents", "name": "WORKSPACE_EVENTS" }
        ]
      },
      // Preview shares production's mart bucket too, matching Turso/waitlist D1 sharing.
      "r2_buckets": [{ "binding": "MART_BUCKET", "bucket_name": "agent-canvas" }],
      // Preview shares production's waitlist D1, matching Turso/R2 sharing.
      "d1_databases": [
        {
          "binding": "WAITLIST",
          "database_name": "cedarpad-waitlist",
          "database_id": "eb4a65d7-6e26-4d98-b893-3b52f901726c"
        },
        // Redeclared verbatim from the top level (named envs inherit no bindings) — same
        // database as production, matching how preview already shares Turso/R2/waitlist.
        {
          "binding": "PLATFORM_DB",
          "database_name": "cedarpad-platform",
          "database_id": "88690b7f-216c-4110-823e-9e50b346b974",
          "migrations_dir": "web-poc/lib/db/migrations"
        }
      ],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Sandbox"] },
        { "tag": "v2", "new_sqlite_classes": ["Warehouse"] },
        { "tag": "v3", "new_sqlite_classes": ["CanvasSyncRoom"] },
        { "tag": "v4", "new_sqlite_classes": ["WorkspaceEvents"] }
      ]
    }
  }
}
