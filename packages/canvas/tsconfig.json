{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun", "node", "react", "react-dom", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  },
  "include": ["src", "server", "shared", "scripts", "lib", "vite.config.ts", "drizzle.config.ts"],
  "// canvas-components": "Agent-authored at runtime; vite/esbuild compiles them (no type gate), so keep them out of the project typecheck.",
  "exclude": ["node_modules", "dist", "src/canvas-components"]
}
