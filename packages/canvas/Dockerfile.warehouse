# agent-canvas WAREHOUSE container (ADR-0017, #236) — a SEPARATE container class from
# Sandbox (this package's Dockerfile), on the same base + pinned tag so the two share a
# kernel/libc and the @cloudflare/sandbox control-plane entrypoint. Carries the Python
# transform toolchain (uv + duckdb + dbt-duckdb + dlt) that Sandbox deliberately does
# NOT — see ADR-0017 "Why two containers": with one container, keeping a future
# extraction secret (Slack/Stripe/Mercury) out of chat-turn reach is enforced by careful
# code; with two, this container simply never runs the agent SDK a chat turn goes
# through, so the secret has no path in. Runs the daily materialize Job (ADR-0015), not
# an always-on daemon — dispatching that job is a separate issue (out of scope here).
#
# The base image's /container-server entrypoint MUST stay (same reasoning as the sibling
# Dockerfile) — do NOT add ENTRYPOINT/CMD.
FROM docker.io/cloudflare/sandbox:0.12.1

# python3 + pip: the base image has NONE (verified for ADR-0017 — Ubuntu 22.04/jammy).
# unzip: needed to unpack the duckdb CLI release below. Unpinned apt packages, matching
# the sibling Dockerfile's convention for tools not pinned by download URL.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip unzip \
  && rm -rf /var/lib/apt/lists/*

# uv: fast, reproducible Python package installer for the dbt/dlt toolchain below.
# Pinned release so a cold rebuild can't silently pick up a breaking uv version.
RUN wget -nv -O /tmp/uv-installer.sh https://astral.sh/uv/0.5.11/install.sh \
  && sh /tmp/uv-installer.sh \
  && rm /tmp/uv-installer.sh \
  && mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/
ENV PATH="/usr/local/bin:${PATH}"

# duckdb + dbt-duckdb + dlt: the materialize toolchain (ADR-0017), ALL THREE pinned
# together — an unpinned dbt-duckdb/dlt next to a pinned duckdb is the fragile
# combination: a rebuild months from now would resolve the unpinned two to whatever's
# current, which may demand a duckdb version the pin forbids, breaking the build for
# reasons unrelated to any code change here. Versions current as of this Dockerfile's
# authoring; bump all three together, deliberately, not just the one that changed.
# `--system` installs onto the image's python3 directly (no venv) — this container runs
# exactly one job at a time (the materialize Job), so there's no dependency-isolation
# need a venv would buy, and `--system` keeps `dbt`/`dlt` on PATH.
RUN uv pip install --system --no-cache duckdb==1.5.5 dbt-duckdb==1.10.1 dlt==1.29.1

# duckdb CLI, pinned to the SAME version as the python `duckdb` package above so the CLI
# and the Python bindings read/write the identical on-disk/parquet format.
RUN ARCH=$(dpkg --print-architecture) \
  && case "$ARCH" in \
       amd64) DUCKDB_ARCH=linux-amd64 ;; \
       arm64) DUCKDB_ARCH=linux-arm64 ;; \
       *) echo "unsupported arch: $ARCH" >&2 && exit 1 ;; \
     esac \
  && wget -nv -O /tmp/duckdb.zip "https://github.com/duckdb/duckdb/releases/download/v1.5.5/duckdb_cli-${DUCKDB_ARCH}.zip" \
  && unzip -o /tmp/duckdb.zip -d /usr/local/bin \
  && rm /tmp/duckdb.zip \
  && chmod +x /usr/local/bin/duckdb

# Bake the pipeline source (#237) — this image COPYs no application code otherwise.
# `bun` ships in the base image (same as the sibling Dockerfile), so no runtime install is
# needed; only the TS deps the warehouse pipeline imports (zod for the mart contract, the
# blob-store R2 backend) matter, which live in the canvas package's own manifest. Same
# layer-caching shape as the sibling Dockerfile: manifests + install BEFORE source, so a
# code-only change doesn't bust the install layer. Build context is the repo root
# (wrangler.jsonc `image_build_context: "../.."`), matching the sibling.
WORKDIR /app/agent-canvas
COPY package.json bun.lock tsconfig.json ./
COPY packages/canvas/package.json packages/canvas/
COPY packages/infra/package.json packages/infra/
RUN bun install --frozen-lockfile || bun install
COPY packages/canvas/server/warehouse packages/canvas/server/warehouse
COPY packages/canvas/server/blob-store.ts packages/canvas/server/blob-store.ts
COPY packages/infra packages/infra
WORKDIR /app/agent-canvas/packages/canvas
