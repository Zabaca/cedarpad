
# local canvas-persistence blobs (dev fs backend)
.persist/

# Playwright e2e artifacts
/test-results/
/playwright-report/
/playwright/.cache/

# build stamps written by scripts/deploy.sh right before the image build: the git SHA and
# the released version the bridge reports at /api/buildrev (ADR-0025). Regenerated per
# deploy, never committed — the committed record of a version is the git tag.
server/build-rev.txt
server/version.txt

# per-canvas component dirs are workspace content (persisted to R2, ADR-0014) —
# only the platform base library is committed
src/canvas-*/
!src/canvas-components/
huddles/

# workspace skills are Records (ADR-0022) rendered here before each turn — only the plugin
# manifest is committed (server/skills.ts)
/workspace-skills/skills/
