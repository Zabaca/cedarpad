{
  "name": "@cedarpad/web-poc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./embed": "./src/embed.tsx",
    "./worker": "./worker/index.ts",
    "./db": "./lib/db/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:db": "turso dev -f ./.turso-local.db -p ${TURSO_DEV_PORT:-8081}",
    "dev:worker": "bun scripts/worker.ts",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "gen:api": "openapi-typescript ./openapi.json -o src/api-types.ts",
    "openapi:emit": "bun scripts/emit-openapi.ts",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "seed": "bun scripts/seed.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@better-auth/api-key": "^1.6.0",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.19.2",
    "@libsql/client": "^0.15.0",
    "@mantine/core": "^7.15.0",
    "@mantine/hooks": "^7.15.0",
    "@mantine/notifications": "^7.15.0",
    "@tanstack/react-query": "^5.62.0",
    "@xyflow/react": "^12.3.0",
    "ably": "^2.5.0",
    "ai": "^5.0.0",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.20",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.42.2",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "drizzle-kit": "^0.30.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3",
    "vite": "8.1.0",
    "vitest": "^3.0.5",
    "wrangler": "4.104.0"
  }
}
