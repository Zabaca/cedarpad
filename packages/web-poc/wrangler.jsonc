{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cedarpad-web-poc",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  // Single worker serves the API and the Vite-built SPA. API prefixes hit the
  // worker first (`run_worker_first`); everything else falls back to the SPA
  // assets with client-side routing (`single-page-application`).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/doc", "/ui", "/health"]
  }
  // Secrets (TURSO_URL, TURSO_KEY, ABLY_API_KEY, ANTHROPIC_API_KEY,
  // OPENAI_API_KEY, BETTER_AUTH_SECRET) are pushed by the zbc cloudflare module
  // after deploy. BETTER_AUTH_URL should be set to the deployed origin (var or
  // secret) once the Worker URL is known. Local dev uses .dev.vars.
}
