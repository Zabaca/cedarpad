{
  "name": "@cedarpad/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun run --bun vitest run",
    "test:watch": "bun run --bun vitest",
    "build:sidecar": "bun build src-sidecar/src/server.ts --outfile dist-sidecar/server.js --target=bun",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:debug:bin": "bun run build:vite && bunx --bun tauri build --debug --no-bundle",
    "test:e2e:webview": "bun run build:debug:bin && node node_modules/@wdio/cli/bin/wdio.js run e2e/webview/wdio.conf.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@libsql/client": "^0.14.0",
    "fractional-indexing": "^3.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@wdio/cli": "^9.27.1",
    "@wdio/globals": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "webdriverio": "^9.27.1"
  }
}
