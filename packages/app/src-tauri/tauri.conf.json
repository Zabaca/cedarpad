{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cedarpad",
  "version": "0.1.0",
  "identifier": "dev.zabaca.cedarpad",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "beforeBuildCommand": "bun run build:vite",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cedarpad",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": [
      "sidecar/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Outliner with per-node Claude Code threads",
    "longDescription": "cedarpad turns repo Q&A into a tree: any outline node can become a Claude Code thread, every response renders as branchable Block nodes, and every fork is a sibling subtree you can compare side-by-side.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
