---
interface Props {
  title?: string
  description?: string
  /** Form-result pages set this: keep them out of indexes, skip the canonical. */
  noindex?: boolean
}

const {
  title = 'cedarpad — the pad you and your agent both draw on',
  description = 'An infinite canvas you and an agent share. It reads your sketches, draws on the board, writes live React components, and opens PRs on your repos.',
  noindex = false,
} = Astro.props

const ogImage = new URL('/og.png', Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={Astro.site} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:title" content="cedarpad — one canvas, your hand and the agent's" />
    <meta
      property="og:description"
      content="A spatial workspace where the agent works on the same surface you do: reads the board, draws on it, builds live components, and opens real pull requests. Invite-only."
    />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  /* Design tokens — DESIGN.md (packages/canvas/DESIGN.md) is the source of truth. */
  :root {
    --void: oklch(0.16 0.01 60);
    --surface: oklch(0.21 0.012 60);
    --raised: oklch(0.25 0.013 60);
    --overlay: oklch(0.29 0.014 60);
    --line: oklch(0.32 0.016 60);
    --line-strong: oklch(0.41 0.018 60);
    --text: oklch(0.93 0.008 75);
    --muted: oklch(0.69 0.014 65);
    --faint: oklch(0.6 0.014 60);
    --accent: oklch(0.68 0.145 45);
    --accent-hi: oklch(0.75 0.14 45);
    --accent-quiet: oklch(0.45 0.08 45);
    --on-accent: oklch(0.18 0.012 60);
    --danger: oklch(0.62 0.18 25);
    --success: oklch(0.65 0.12 150);
    --shadow-float: 0 1px 2px oklch(0.1 0.01 60 / 0.5), 0 0 0 1px var(--line);
    --shadow-lift: 0 8px 24px oklch(0.07 0.01 60 / 0.55);
    --sans: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Cascadia Code', Menlo, monospace;
    color-scheme: dark;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--void);
    color: var(--text);
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 10;
    background: var(--accent);
    color: var(--on-accent);
    padding: 8px 14px;
    border-radius: 0 0 10px 0;
    font-weight: 600;
    text-decoration: none;
  }
  .skip:focus {
    left: 0;
  }
  .label {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }
  code {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text);
    background: var(--surface);
    padding: 2px 5px;
    border-radius: 6px;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
