---
// The cedarpad lockup: the pad-and-spark mark plus the split wordmark —
// "cedar" in text, "pad" in Cedar Ember. The wordmark carries the accent so the
// mark stays quiet.
---

<span class="logo">
  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <rect x="5" y="5" width="38" height="38" rx="11" stroke="currentColor" stroke-width="4"></rect>
    <circle cx="30.5" cy="17.5" r="5.5" fill="oklch(0.68 0.145 45)"></circle>
  </svg>
  <span class="word">cedar<b>pad</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  svg {
    width: 17px;
    height: 17px;
    color: var(--muted);
  }
  .word b {
    color: var(--accent);
    font-weight: 600;
  }
</style>
