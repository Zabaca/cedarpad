---
// The hero visual (decided on the Variant test board, 2026-07-18): the minimal
// three-variant alignment ritual — named votes, one decided, teammate + agent
// cursors — on the canvas dot grid. Pure CSS/inline-SVG; motion is a light
// touch (cursor drift + decided ring settle) behind prefers-reduced-motion.
---

<div
  class="pad"
  role="img"
  aria-label="Three design variants on a shared canvas with votes; one is decided; a teammate's and an agent's cursors point at the board"
>
  <div class="q">Which pricing page do we ship?</div>
  <div class="cards">
    <div class="card dim">
      <div class="t">Variant A</div>
      <div class="mini">
        <i class="l" style="width: 70%"></i>
        <span class="bars"><b style="height: 12px"></b><b style="height: 22px"></b><b style="height: 16px"></b></span>
      </div>
      <div class="v">1 · noor</div>
    </div>
    <div class="card won">
      <div class="t">Variant B <span class="tick">✓</span></div>
      <div class="mini">
        <i class="l" style="width: 70%"></i>
        <span class="bars win"><b style="height: 12px"></b><b style="height: 22px"></b><b style="height: 16px"></b></span>
      </div>
      <div class="v">2 · james, cedar</div>
    </div>
    <div class="card dim">
      <div class="t">Variant C</div>
      <div class="mini">
        <i class="l" style="width: 70%"></i>
        <span class="bars"><b style="height: 12px"></b><b style="height: 22px"></b><b style="height: 16px"></b></span>
      </div>
      <div class="v">no votes</div>
    </div>
  </div>
  <div class="peer peer-h" aria-hidden="true">
    <svg width="12" height="12" viewBox="0 0 13 13" fill="none"><path d="M1 1 L 12 6 L 7 7.5 L 5 12.5 Z" fill="currentColor"></path></svg>
    <span>noor</span>
  </div>
  <div class="peer peer-a" aria-hidden="true">
    <svg width="12" height="12" viewBox="0 0 13 13" fill="none"><path d="M1 1 L 12 6 L 7 7.5 L 5 12.5 Z" fill="currentColor"></path></svg>
    <span>cedar · agent</span>
  </div>
</div>

<style>
  .pad {
    position: relative;
    background: var(--surface);
    border-radius: 14px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lift);
    padding: 20px;
    min-height: 340px;
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 20px 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .q {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .cards {
    display: flex;
    gap: 10px;
  }
  .card {
    flex: 1;
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 10px;
  }
  .card.won {
    border: 2px solid oklch(0.65 0.12 150);
  }
  .card.dim {
    opacity: 0.6;
  }
  .t {
    font-size: 0.75rem;
    font-weight: 700;
  }
  .tick {
    color: oklch(0.65 0.12 150);
  }
  .mini {
    margin: 9px 0;
    height: 56px;
    border-radius: 8px;
    background: var(--void, #161513);
    border: 1px solid var(--line);
    padding: 8px;
  }
  .mini .l {
    display: block;
    height: 7px;
    border-radius: 4px;
    background: var(--line);
    margin-bottom: 8px;
  }
  .bars {
    display: flex;
    gap: 4px;
    align-items: flex-end;
    height: 24px;
  }
  .bars b {
    width: 12px;
    background: var(--line);
    border-radius: 3px 3px 0 0;
  }
  .bars.win b {
    background: oklch(0.65 0.12 150);
  }
  .v {
    font-size: 0.65rem;
    color: var(--muted);
    font-family: var(--mono);
  }
  .peer {
    position: absolute;
    display: flex;
    align-items: flex-start;
    gap: 3px;
  }
  .peer span {
    font-size: 0.65rem;
    font-family: var(--mono);
    border-radius: 5px;
    padding: 1px 5px;
    margin-top: 7px;
  }
  .peer-h {
    left: 36%;
    bottom: 14%;
    color: oklch(0.62 0.13 220);
  }
  .peer-h span {
    background: oklch(0.62 0.13 220);
    color: oklch(0.16 0 0);
  }
  .peer-a {
    right: 8%;
    top: 16%;
    color: var(--accent);
  }
  .peer-a span {
    background: var(--accent);
    color: var(--on-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .peer-h {
      animation: drift 9s ease-in-out infinite alternate;
    }
    .peer-a {
      animation: drift 11s ease-in-out infinite alternate-reverse;
    }
    .card.won {
      animation: settle 0.6s ease-out 0.8s backwards;
    }
  }
  @keyframes drift {
    0% { transform: translate(0, 0); }
    35% { transform: translate(26px, -16px); }
    70% { transform: translate(-12px, 10px); }
    100% { transform: translate(18px, -5px); }
  }
  @keyframes settle {
    from { border-color: var(--line); }
  }
  @media (max-width: 460px) {
    .cards { flex-direction: column; }
    .peer { display: none; }
    .pad { min-height: 0; }
  }
</style>
