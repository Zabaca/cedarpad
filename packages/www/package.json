{
  "name": "@cedarpad/www",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "wrangler types && astro preview",
    "typecheck": "wrangler types && astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:migrate:local": "wrangler d1 migrations apply cedarpad-waitlist --local",
    "db:migrate:remote": "wrangler d1 migrations apply cedarpad-waitlist --remote"
  },
  "dependencies": {
    "astro": "^7.0.9",
    "@astrojs/cloudflare": "^14.1.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^25",
    "typescript": "^5.7.0",
    "wrangler": "^4.83.0"
  }
}
